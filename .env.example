NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=./data/scorerr.db
SCORERR_PUBLIC_URL=http://scorerr:3000
# Optional: base64 (32 bytes) or 64 hexadecimal characters. Otherwise a persistent local key is generated.
SCORERR_MASTER_KEY=
# Keep false until the read-only Radarr/Seerr probe has validated the remote contracts.
SETUP_WRITES_ENABLED=false
SETUP_NON_PERSISTENT_TESTS_ENABLED=false
SETUP_SEERR_PROBE_WRITE_ENABLED=false
HTTP_TIMEOUT_MS=5000
HTTP_MAX_RESPONSE_BYTES=2097152
LOG_LEVEL=info
BODY_LIMIT_BYTES=1048576
WORKER_POLL_INTERVAL_MS=1000
WORKER_SCHEMA_WAIT_INTERVAL_MS=1000
WORKER_LOCK_TIMEOUT_MS=300000
WORKER_MAX_ATTEMPTS=3
DOCKER_NETWORK_NAME=scorerr-network
SCORERR_IMAGE=ghcr.io/PROPRIETAIRE_GITHUB/scorerr:latest
PORT_SCORERR=3000
SCORERR_VOLUME_NAME=scorerr-data
